# Telegram Bot Configuration (Get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN="your_bot_token_here"
NEXT_PUBLIC_BOT_USERNAME="YourDownloaderBot"

# Force-Subscribe Channel Details (The channel users must join)
# Username format: @YourChannel (without https://t.me/)
# Channel ID format: -100xxxxxxxxxx (Get from @userinfobot or channel info)
TELEGRAM_CHANNEL_USERNAME="@YourChannel"
TELEGRAM_CHANNEL_ID="-1001234567890"

# Mini App & Webhook URL (Your Vercel deployment URL)
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
WEBHOOK_SECRET="random_secure_string_here"

# Database URL (Neon / Supabase / PostgreSQL)
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
